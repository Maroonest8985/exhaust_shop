DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require

# Local development (npm run dev)
LOCAL_ADMIN_EMAIL=local-admin@example.com
LOCAL_ADMIN_PASSWORD=replace-with-a-local-random-password
LOCAL_ADMIN_SESSION_SECRET=replace-with-at-least-32-local-random-bytes

# Production / Vercel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
